<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width">
<title>Your email was changed</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f4f7;padding:32px 16px;">
<tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px;background:#ffffff;border-radius:12px;border:1px solid #e3e5e8;">
<tr><td style="padding:32px 32px 8px;font-size:20px;font-weight:700;">Your email was changed</td></tr>
<tr><td style="padding:0 32px;font-size:15px;line-height:1.55;">
<p style="margin:12px 0;">Hi {{.Username}},</p>
<p style="margin:12px 0;">The email address of your account on <strong>{{.InstanceName}}</strong> was changed to <strong>{{.MaskedEmail}}</strong>. This address is no longer used to sign in or to reset your password.</p>
<p style="margin:12px 0;">If you did not make this change, contact the administrator of {{.InstanceName}} - they can move the account back to an address you control.</p>
</td></tr>
<tr><td style="padding:16px 32px 28px;font-size:12px;color:#8b949e;">{{.InstanceName}}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width">
<title>Verify your email</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f4f7;padding:32px 16px;">
<tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px;background:#ffffff;border-radius:12px;border:1px solid #e3e5e8;">
<tr><td style="padding:32px 32px 8px;font-size:20px;font-weight:700;">Verify your email</td></tr>
<tr><td style="padding:0 32px;font-size:15px;line-height:1.55;">
<p style="margin:12px 0;">Hi {{.Username}},</p>
<p style="margin:12px 0;">Confirm that this is your email address for your account on <strong>{{.InstanceName}}</strong>.</p>
<p style="margin:24px 0;text-align:center;">
<a href="{{.Link}}" style="display:inline-block;background:#5865f2;color:#ffffff;text-decoration:none;font-weight:600;padding:12px 24px;border-radius:8px;">Verify email</a>
</p>
<p style="margin:12px 0;font-size:13px;color:#57606a;">Or paste this link into your browser:<br><a href="{{.Link}}" style="color:#5865f2;word-break:break-all;">{{.Link}}</a></p>
<p style="margin:12px 0;font-size:13px;color:#57606a;">The link works once and expires in {{.ExpiresIn}}. If you did not create an account on {{.InstanceName}}, you can ignore this email - nothing happens unless the link is opened.</p>
</td></tr>
<tr><td style="padding:16px 32px 28px;font-size:12px;color:#8b949e;">{{.InstanceName}}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
